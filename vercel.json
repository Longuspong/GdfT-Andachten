{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "eleventy",
  "buildCommand": "npm run build",
  "outputDirectory": "_site",
  "trailingSlash": true,
  "functions": {
    "api/andachten.js": { "maxDuration": 60 },
    "api/taeglich.js": { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/taeglich",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/taeglich",
      "schedule": "0 5 * * *"
    }
  ]
}
