<header class="kopf">
  <div class="kopf__innen">
    <a class="marke" href="/">
      <img class="marke__logo" src="/assets/logo-rund.png" width="64" height="64"
           alt="Logo: Gerüstet für den Tag" />
      <span class="marke__text">
        <span class="marke__name">{{ site.name }}</span>
        <span class="marke__zusatz">{{ site.kurzbeschreibung }}</span>
      </span>
    </a>

    <nav class="nav" aria-label="Hauptnavigation">
      <a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>Heute</a>
      <a href="/archiv/"{% if page.url.startsWith("/archiv") %} aria-current="page"{% endif %}>Archiv</a>
      <a href="/bibel/"{% if page.url.startsWith("/bibel") %} aria-current="page"{% endif %}>Bibel</a>
      <a href="/ueber/"{% if page.url.startsWith("/ueber") %} aria-current="page"{% endif %}>Über</a>
    </nav>

    {# Schieberegler für den Dunkelmodus (oben rechts). Er zeigt bei hellem
       Design eine Sonne, bei dunklem einen Mond. Ohne JavaScript bleibt er
       ausgeblendet, weil er dann keine Funktion hätte – die Seite folgt in
       diesem Fall automatisch der Systemeinstellung. #}
    <button
      type="button"
      class="thema-schalter"
      role="switch"
      aria-checked="false"
      aria-label="Dunkelmodus ein- oder ausschalten"
      title="Zwischen hellem und dunklem Design wechseln"
    >
      <span class="thema-schalter__spur" aria-hidden="true">
        <span class="thema-schalter__knopf">
          <svg class="thema-schalter__icon thema-schalter__icon--sonne" viewBox="0 0 24 24" focusable="false">
            <circle cx="12" cy="12" r="4.4" fill="currentColor" />
            <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="12" y1="1.6" x2="12" y2="4.2" />
              <line x1="12" y1="19.8" x2="12" y2="22.4" />
              <line x1="1.6" y1="12" x2="4.2" y2="12" />
              <line x1="19.8" y1="12" x2="22.4" y2="12" />
              <line x1="4.6" y1="4.6" x2="6.4" y2="6.4" />
              <line x1="17.6" y1="17.6" x2="19.4" y2="19.4" />
              <line x1="4.6" y1="19.4" x2="6.4" y2="17.6" />
              <line x1="17.6" y1="6.4" x2="19.4" y2="4.6" />
            </g>
          </svg>
          <svg class="thema-schalter__icon thema-schalter__icon--mond" viewBox="0 0 24 24" focusable="false">
            <path d="M20.5 14.8A8.2 8.2 0 0 1 9.2 3.5 7.3 7.3 0 1 0 20.5 14.8Z" fill="currentColor" />
          </svg>
        </span>
      </span>
    </button>
  </div>
</header>
