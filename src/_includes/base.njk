<!doctype html>
<html lang="{{ site.sprache }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    {# Design (hell/dunkel) so früh wie möglich festlegen, damit die Seite nicht
       kurz in der falschen Farbe aufblitzt. Nur wenn der Nutzer über den
       Schalter ausdrücklich gewählt hat, wird ein Attribut gesetzt – sonst
       greift automatisch die Systemeinstellung. Die Klasse „js“ blendet den
       Schalter erst ein, wenn JavaScript verfügbar ist. #}
    <script>
      (function () {
        try {
          var wurzel = document.documentElement;
          wurzel.classList.add("js");
          var wahl = null;
          try { wahl = localStorage.getItem("thema"); } catch (e) {}
          if (wahl === "hell" || wahl === "dunkel") {
            wurzel.setAttribute("data-theme", wahl === "dunkel" ? "dark" : "light");
          }
        } catch (e) {}
      })();
    </script>

    <meta name="theme-color" content="#1f3550" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141a22" media="(prefers-color-scheme: dark)" />
    <title>{% if titel %}{{ titel }} · {{ site.name }}{% else %}{{ site.name }} · {{ site.kurzbeschreibung }}{% endif %}</title>
    <meta name="description" content="{{ beschreibung or site.beschreibung }}" />

    {# Immer auf die kanonische Adresse dieser Seite verweisen #}
    <link rel="canonical" href="{{ page.url | absolut }}" />

    <!-- Vorschau für geteilte Links (Open Graph) -->
    <meta property="og:type" content="{{ ogTyp or 'website' }}" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:locale" content="{{ site.sprache }}_{{ site.sprache | upper }}" />
    <meta property="og:title" content="{% if titel %}{{ titel }}{% else %}{{ site.name }}{% endif %}" />
    <meta property="og:description" content="{{ beschreibung or site.beschreibung }}" />
    <meta property="og:url" content="{{ page.url | absolut }}" />
    <meta property="og:image" content="{{ (bild or site.vorschaubild) | absolut }}" />
    <meta property="og:image:secure_url" content="{{ (bild or site.vorschaubild) | absolut }}" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:image:alt" content="Logo: {{ site.name }} – Bibel, Kreuz, Taube und Ähren" />
    {% if ogTyp == "article" and page.date %}
      <meta property="article:published_time" content="{{ page.date | datumRFC3339 }}" />
    {% endif %}

    <!-- Vorschau bei Twitter/X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{% if titel %}{{ titel }}{% else %}{{ site.name }}{% endif %}" />
    <meta name="twitter:description" content="{{ beschreibung or site.beschreibung }}" />
    <meta name="twitter:image" content="{{ (bild or site.vorschaubild) | absolut }}" />

    {# Strukturierte Daten (JSON-LD) – helfen Suchmaschinen, die Seite als
       Website bzw. jede Andacht als Beitrag zu verstehen (Rich Results). #}
    {% set ld_url = page.url | absolut %}
    {% set ld_bild = (bild or site.vorschaubild) | absolut %}
    {% set ld_logo = "/assets/logo.png" | absolut %}
    {% if ogTyp == "article" %}
      {% set ld = {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": titel,
        "description": (beschreibung or site.beschreibung),
        "inLanguage": site.sprache,
        "datePublished": (page.date | datumRFC3339),
        "dateModified": (page.date | datumRFC3339),
        "url": ld_url,
        "mainEntityOfPage": ld_url,
        "image": ld_bild,
        "isPartOf": { "@type": "WebSite", "name": site.name, "url": site.url + "/" },
        "author": { "@type": "Organization", "name": site.name, "url": site.url + "/" },
        "publisher": {
          "@type": "Organization",
          "name": site.name,
          "logo": { "@type": "ImageObject", "url": ld_logo }
        }
      } %}
    {% else %}
      {% set ld = {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": site.name,
        "alternateName": site.kurzbeschreibung,
        "description": site.beschreibung,
        "inLanguage": site.sprache,
        "url": site.url + "/",
        "publisher": {
          "@type": "Organization",
          "name": site.name,
          "logo": { "@type": "ImageObject", "url": ld_logo }
        }
      } %}
    {% endif %}
    <script type="application/ld+json">{{ ld | jsonLd | safe }}</script>

    <!-- RSS-/Atom-Feed für Leser, die nicht täglich vorbeischauen -->
    <link rel="alternate" type="application/atom+xml" title="{{ site.name }} – {{ site.kurzbeschreibung }}" href="/feed.xml" />

    <link rel="icon" href="/assets/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/logo.png" />

    {# Schriften werden selbst ausgeliefert (nicht vom Google-CDN): kein
       Übertragen von Besucher-IPs an Google (DSGVO) und kein render-blockender
       Fremd-Request. Definitionen und Dateien: src/css/fonts.css bzw.
       src/assets/fonts/. #}
    <link rel="stylesheet" href="/css/fonts.css" />
    <link rel="stylesheet" href="/css/style.css" />
    <script src="/js/thema.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>

    {% include "partials/header.njk" %}

    <main id="inhalt" class="inhalt">
      {{ content | safe }}
    </main>

    {% include "partials/footer.njk" %}
  </body>
</html>
