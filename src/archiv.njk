---
layout: base.njk
titel: Archiv
beschreibung: Alle bisher erschienenen Andachten im Überblick.
permalink: /archiv/index.html
---
<section class="seite-kopf">
  <div class="seite-kopf__innen">
    <p class="rubrik" style="color:var(--gold)">Archiv</p>
    <h1 class="seite-kopf__titel">Alle Andachten</h1>
    <p class="seite-kopf__text">
      {{ collections.andachten.length }} Andachten, nach Datum.
      Lieber nach Bibelstelle? <a href="/bibel/" style="color:inherit">Nach Bibelbuch blättern →</a>
    </p>
  </div>
</section>

<div class="inhalt">
  {% if collections.andachten.length %}
    {# Nach Monat gruppiert. Da {% raw %}{% set %}{% endraw %} in Nunjucks die Schleife nicht überlebt,
       wird der Monatswechsel über den jeweils vorigen bzw. nächsten Eintrag
       der Sammlung erkannt. #}
    {% for andacht in collections.andachten %}
      {% set monat = andacht.date | datumMonatJahr %}
      {% set beginnt = loop.first or (collections.andachten[loop.index0 - 1].date | datumMonatJahr) != monat %}
      {% set endet = loop.last or (collections.andachten[loop.index0 + 1].date | datumMonatJahr) != monat %}

      {% if beginnt %}
        <section class="monat">
          <div class="monat__kopf"><p class="monat__name">{{ monat }}</p></div>
          <div class="monat__liste">
            <ul style="list-style:none;margin:0;padding:0">
      {% endif %}

              <li>
                <a class="monat__link" href="{{ andacht.url }}">
                  <span class="monat__tag">{{ andacht.date | datumTag }}</span>
                  <span class="monat__titel">{{ andacht.data.titel }}</span>
                  {% if andacht.data.stelle %}<span class="monat__stelle">{{ andacht.data.stelle }}</span>{% endif %}
                </a>
              </li>

      {% if endet %}
            </ul>
          </div>
        </section>
      {% endif %}
    {% endfor %}
  {% else %}
    <p>Es sind noch keine Andachten vorhanden.</p>
  {% endif %}
</div>
