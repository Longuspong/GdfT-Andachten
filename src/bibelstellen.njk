---
layout: base.njk
titel: Nach Bibelstelle
beschreibung: Alle Andachten nach Bibelbuch und Kapitel durchblättern.
permalink: /bibel/index.html
---
<section class="seite-kopf">
  <div class="seite-kopf__innen">
    <p class="rubrik" style="color:var(--gold)">Nach Bibelstelle</p>
    <h1 class="seite-kopf__titel">Quer durch die Schrift</h1>
    <p class="seite-kopf__text">
      Bücher mit Andachten sind anklickbar.
      Lieber der Reihe nach? <a href="/archiv/" style="color:inherit">Zum Archiv nach Datum →</a>
    </p>
  </div>
</section>

<div class="inhalt">
  <nav aria-label="Bibelbücher">
    <div class="block__kopf"><h2 class="block__titel">Altes Testament</h2></div>
    <div class="buch-raster">
      {% for buch in collections.bibel %}{% if buch.testament == "at" %}
        {% if buch.anzahl %}
          <a class="buch-chip buch-chip--aktiv" href="#buch-{{ buch.slug }}">
            <span>{{ buch.kurz }}</span>
            <span class="buch-chip__zahl" aria-label="{{ buch.anzahl }} Andachten">{{ buch.anzahl }}</span>
          </a>
        {% else %}
          <span class="buch-chip buch-chip--leer" aria-disabled="true">{{ buch.kurz }}</span>
        {% endif %}
      {% endif %}{% endfor %}
    </div>

    <div class="block__kopf"><h2 class="block__titel">Neues Testament</h2></div>
    <div class="buch-raster">
      {% for buch in collections.bibel %}{% if buch.testament == "nt" %}
        {% if buch.anzahl %}
          <a class="buch-chip buch-chip--aktiv" href="#buch-{{ buch.slug }}">
            <span>{{ buch.kurz }}</span>
            <span class="buch-chip__zahl" aria-label="{{ buch.anzahl }} Andachten">{{ buch.anzahl }}</span>
          </a>
        {% else %}
          <span class="buch-chip buch-chip--leer" aria-disabled="true">{{ buch.kurz }}</span>
        {% endif %}
      {% endif %}{% endfor %}
    </div>
  </nav>

  {% for buch in collections.bibel %}{% if buch.anzahl %}
    <section id="buch-{{ buch.slug }}" style="scroll-margin-top:1rem">
      <div class="buch-fokus">
        <p class="rubrik buch-fokus__rubrik">{{ buch.name }} · {{ buch.anzahl }} Andachten</p>
        <p class="buch-fokus__info">{{ buch.kapitel.length }} Kapitel begleitet</p>
      </div>

      <ul class="kapitel-liste">
        {% for kap in buch.kapitel %}
          <li>
            <div class="block__kopf"><h3 class="block__titel">Kapitel {{ kap.nummer }}</h3></div>
            <ul style="list-style:none;margin:0 0 1.5rem;padding:0">
              {% for e in kap.eintraege %}
                <li>
                  <a class="monat__link" href="{{ e.andacht.url }}" style="grid-template-columns:1fr auto">
                    <span class="monat__titel">{{ e.andacht.data.titel }}</span>
                    <span class="monat__stelle" style="grid-column:2">{{ e.andacht.data.stelle }}</span>
                  </a>
                </li>
              {% endfor %}
            </ul>
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}{% endfor %}
</div>
