# Diese Werte NICHT hier eintragen, sondern in Vercel unter:
# Project Settings -> Environment Variables

# Passwort für den Login unter /admin/
ADMIN_PASSWORD=

# Zufälliger, langer geheimer Text zum Signieren der Login-Sitzung
# (z. B. erzeugen mit: openssl rand -hex 32)
SESSION_SECRET=

# GitHub Personal Access Token (fine-grained), nur für DIESES Repo,
# Berechtigung "Contents: Read and write"
GITHUB_TOKEN=

# z. B. "dein-github-name"
GITHUB_OWNER=

# z. B. "GdfT-Andachten"
GITHUB_REPO=

# Branch, auf den Vercel automatisch deployt (meist "main")
GITHUB_BRANCH=main

# --- Geplantes Veröffentlichen (vordatierte Andachten) ---
# Vercel "Deploy Hook"-URL: Project Settings -> Git -> Deploy Hooks anlegen
# (Branch "main"). Der tägliche Cron-Job (/api/taeglich) ruft diese URL auf,
# damit eine auf ein zukünftiges Datum gesetzte Andacht an ihrem Tag automatisch
# erscheint. Ohne diesen Wert erscheint sie erst beim nächsten Speichern/Deploy.
DEPLOY_HOOK_URL=

# Zufälliges Geheimnis, das den Endpunkt /api/taeglich vor fremden Aufrufen
# schützt (z. B. erzeugen mit: openssl rand -hex 32). Dringend empfohlen.
# WICHTIG: Der tägliche Lauf wird morgens von einem externen Cron-Dienst (z. B.
# cron-job.org) aufgerufen, mit GitHub Actions als Reserve. Denselben Wert deshalb
# hinterlegen: (1) beim Cron-Dienst als Header "Authorization: Bearer <Wert>" und
# (2) als GitHub-Actions-Secret: Repo → Settings → Secrets and variables → Actions
# → "CRON_SECRET". Details im README, Abschnitt "Hinweis zum Zeitplan".
CRON_SECRET=

# --- Telegram-Benachrichtigung (optional) ---
# Bot-Token von @BotFather. Leer lassen, um Telegram-Meldungen auszuschalten.
TELEGRAM_BOT_TOKEN=

# Ziel-Kanal/-Chat: Kanalname (z. B. "@morgenandachten") oder numerische Chat-ID.
# Der Bot muss Mitglied (Administrator) des Kanals sein, um posten zu dürfen.
TELEGRAM_CHAT_ID=

# --- E-Mail-Newsletter über Brevo (optional) ---
# Kostenloser EU-Dienst (300 Mails/Tag). Fehlt einer der ersten drei Werte, ist
# das E-Mail-Abo einfach ausgeschaltet (das Anmeldeformular erscheint dann nicht).
# API-Schlüssel: Brevo → SMTP & API → API Keys.
BREVO_API_KEY=

# ID der Kontaktliste (Zahl), in die bestätigte Abonnenten eingetragen werden.
# Brevo → Contacts → Lists (die Zahl in der Listenübersicht).
BREVO_LIST_ID=

# Verifizierte Absender-Adresse (Brevo → Senders, Domains & Dedicated IPs).
BREVO_SENDER_EMAIL=

# Anzeigename des Absenders (optional; sonst wird der Seitenname verwendet).
BREVO_SENDER_NAME=

# Optional: eigenes Geheimnis zum Signieren der Bestätigungs-/Abmeldelinks
# (z. B. openssl rand -hex 32). Ohne diesen Wert wird SESSION_SECRET verwendet.
NEWSLETTER_SECRET=
